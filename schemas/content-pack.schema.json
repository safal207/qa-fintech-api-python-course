{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/content-pack.schema.json",
  "title": "Course Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "questions", "api_labs", "answers"],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "topic"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "skill",
          "topic",
          "question",
          "expected_answer",
          "source_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
          "skill": {"enum": ["recall", "apply", "diagnose", "design", "production"]},
          "topic": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "expected_answer": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "api_labs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "level",
          "endpoint",
          "scenario",
          "tasks",
          "acceptance_criteria",
          "source_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
          "endpoint": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "expected_answer"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "expected_answer": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
